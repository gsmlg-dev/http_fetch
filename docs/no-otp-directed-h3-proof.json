          "date": "2026-11-10",
          "source_commit": "4c1bf8fde8b1fab2f10dcad73183969eed731052",
          "input": "apps/http_runtime/lib/http/http3/connection_owner.ex",
          "change": "ConnectionOwner.terminate/2 now runs QuicHttp3.Session.close/1 under guarded/4 on an orderly :normal stop of a ready or draining owner, then retires the cleanup lease; the :http3_retire handler no longer retires before stopping, so the close is admitted first (RFC 9114 section 5.2, H3_NO_ERROR).",
          "dispatch_review": "No dynamic dispatch added or moved: the new calls are the literal Session.close/1 inside the existing guarded/4 closure invocation, and the file holds no reviewed occurrence. Session.close/1 reaches only the already reviewed retained session.transport close and cleanup operations (H3-1)."
        },
        {
          "date": "2026-11-10",
          "source_commit": "4c1bf8fde8b1fab2f10dcad73183969eed731052",
          "input": "apps/http_runtime/lib/http/http3/pool.ex",
          "change": "HTTP.HTTP3.Pool no longer retires an exclusive owner's cleanup lease on release; it sends :http3_retire so the owner closes with H3_NO_ERROR before retiring, and still retires on owner DOWN.",
          "dispatch_review": "No dynamic dispatch added or moved: one literal Quic.Cleanup.retire/2 call path is removed; the file holds no reviewed occurrence."
        },
        {
          "date": "2026-11-10",
          "source_commit": "51fd8fe49bc8f45d69762cb130cf277a10dd21ab",
          "input": "apps/http_runtime/lib/http/http3/connection_owner.ex",
          "change": "ConnectionOwner marks itself :retiring when the watchdog, attempt tracker or creator goes DOWN, so terminate/2 skips the graceful close of the already retired connection; graceful_close/2 now also requires that no request remains, so a stop that abandons live requests through fail_all/2 keeps the previous retire/abort path instead of claiming H3_NO_ERROR.",
          "dispatch_review": "No dynamic dispatch added or moved: the change is a lifecycle field update and a map_size/1 guard; the file holds no reviewed occurrence."
        },
        {
          "date": "2026-11-10",
          "source_commit": "512fd3ca291b1bd4913781e01d38361823e405f6",
          "input": "apps/http_runtime/lib/http/http3/connection_owner.ex",
          "change": "An extended CONNECT request whose response stream finished is marked done? and no longer counts as live, so graceful_close/2 still sends H3_NO_ERROR after a WebTransport session closed by a compliant peer; any other remaining request keeps suppressing it.",
          "dispatch_review": "No dynamic dispatch added or moved: the change adds a request map field, a put_in/2 update and an Enum.any?/2 over the request map; the file holds no reviewed occurrence."
